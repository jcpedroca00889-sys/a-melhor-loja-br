# A MELHOR LOJA BR — variáveis de ambiente
# ⚠️ NUNCA commitar valores reais! Copie para .env e preencha.

# ---------- Supabase (obrigatório) ----------
# Encontre em: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-sua-service-role-key-aqui

# ---------- Pagamentos Mercado Pago ----------
# PAYMENTS_MODE=simulation (default) | live
PAYMENTS_MODE=simulation
# Access Token do Mercado Pago (painel MP → Developers → Credenciais)
MP_ACCESS_TOKEN=
# Secret para validar a assinatura do webhook do MP (Credentials → Webhooks)
MP_WEBHOOK_SECRET=
# URL pública usada como notification_url do webhook (ex: https://sua-loja.vercel.app/api/webhooks/mp)
# MP_NOTIFICATION_URL=https://sua-loja.vercel.app/api/webhooks/mp

# ---------- Backend / Deploy ----------
# URL pública do backend para o frontend (precisa do prefixo VITE_ no build!)
# Ex: mesmo domínio na Vercel → deixe vazio; backend separado → https://seu-backend.vercel.app
# VITE_API_URL=https://seu-backend.vercel.app

# Porta do servidor (default 3001)
# PORT=3001

# URL pública base (usada para links absolutos; default: http://localhost:PORT)
# PUBLIC_BASE=https://sua-loja.vercel.app

# CORS whitelist (produção) — origens permitidas separadas por vírgula
# ALLOWED_ORIGINS=https://sua-loja.vercel.app

# ---------- Admin ----------
# Senha inicial do usuário admin criado no seed (se vazio, gera aleatória)
# ADMIN_PASSWORD=troque-essa-senha
